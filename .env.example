# NyayaSetu configuration. Copy to `.env` (backend reads ./.env and ../.env).
# Every integration is optional: a missing credential disables that feature and is
# reported on the admin health page; the app keeps working.

# --- Core --------------------------------------------------------------------------
ENVIRONMENT=development                 # development | test | production
SECRET_KEY=change-me-to-a-random-64-char-string   # production: >= 32 random chars
DATABASE_URL=sqlite+aiosqlite:///./nyayasetu.db   # production: postgresql+asyncpg://user:pass@host:5432/nyayasetu
REDIS_URL=                              # e.g. redis://localhost:6379/0 (enables arq worker + shared rate limits)
CORS_ORIGINS=http://localhost:3000      # comma-separated browser origins allowed to call the API / voice socket
PUBLIC_APP_URL=http://localhost:3000    # used in password-reset links
LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=127.0.0.1           # container: addresses of your trusted proxy/load balancer

# --- Auth / cookies --------------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false                     # production: true (HTTPS only)
COOKIE_DOMAIN=
EXPOSE_DEV_RESET_TOKENS=false           # dev only: show reset links when SMTP is not configured
AUTH_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=120

# --- Email (password reset, reminders) ----------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=NyayaSetu <no-reply@example.org>

# --- Storage (uploaded documents are AES-256-GCM encrypted before storage) ---------------
STORAGE_BACKEND=local                   # local | s3
LOCAL_STORAGE_PATH=./var/storage
STORAGE_ENCRYPTION_KEY=                 # base64 of 32 random bytes: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
S3_BUCKET=
S3_ENDPOINT_URL=                        # for S3-compatible stores (MinIO, R2, etc.)
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=20

# --- LLM (optional; used only for users who consent to external AI processing) -----------
LLM_PROVIDER=anthropic                  # anthropic | offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_ENABLE_FALLBACKS=true         # server-side refusal fallbacks (beta)

# --- Embeddings ----------------------------------------------------------------------------
EMBEDDING_PROVIDER=hashing              # hashing (offline, lexical) | openai_compatible
EMBEDDING_DIMENSIONS=384                # changing requires a new migration + re-ingestion
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Speech (Sarvam AI; browser speech is used when unset) ---------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER_HI=priya
SARVAM_TTS_SPEAKER_EN=priya

# --- OCR (scanned documents) ----------------------------------------------------------------
OCR_PROVIDER=tesseract                  # tesseract | none  (needs the tesseract binary + `pip install pytesseract`)
TESSERACT_CMD=

# --- Filing ----------------------------------------------------------------------------------
EJAGRITI_BASE_URL=https://e-jagriti.gov.in
ENABLE_BROWSER_ASSIST=false             # local deployments only; needs `pip install playwright` + browser
BROWSER_ASSIST_HEADLESS=false

# --- Legal knowledge ---------------------------------------------------------------------------
LEGAL_FETCH_LIVE=false                  # re-download official PDFs during ingestion and flag changes

# --- Observability -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend (Next.js) ------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000       # server-side: where Next.js proxies /api/*
NEXT_PUBLIC_API_WS_URL=ws://localhost:8000   # browser: voice WebSocket origin (wss:// in production)
