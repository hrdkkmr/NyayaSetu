# NyayaSetu configuration.
#
#   Local development : copy to `.env` (backend reads ./.env and ../.env) and use the
#                       "local:" values noted in the comments.
#   Render (API)      : add every variable in the backend sections below under
#                       Service -> Environment. Do NOT commit real values.
#   Vercel (web)      : add only the variables in the "Frontend" section at the bottom.
#
# Every integration is optional: a missing credential disables that feature and is
# reported on the admin health page; the app keeps working.
# The API refuses to start with ENVIRONMENT=production if SECRET_KEY is weak, COOKIE_SECURE
# is false, DATABASE_URL is SQLite, EXPOSE_DEV_RESET_TOKENS is true or CORS_ORIGINS has '*'.

# --- Core --------------------------------------------------------------------------
ENVIRONMENT=production                  # local: development
SECRET_KEY=                             # >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Render Postgres: copy its *Internal* Database URL and change the scheme
#   postgresql://...  ->  postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/nyayasetu   # local: sqlite+aiosqlite:///./nyayasetu.db
REDIS_URL=                              # optional (Render Key Value / redis://...); unset = jobs run in-process
CORS_ORIGINS=https://YOUR-APP.vercel.app   # comma-separated; must include the Vercel URL (voice socket checks Origin). local: http://localhost:3000
PUBLIC_APP_URL=https://YOUR-APP.vercel.app # used in password-reset links. local: http://localhost:3000
LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=*                   # Render: the service is only reachable through Render's proxy. local/other hosts: 127.0.0.1 or your proxy IPs
PORT=8000                               # Render: the port the container listens on (backend/Dockerfile uses 8000)

# --- Auth / cookies --------------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=true                      # local: false (plain http)
COOKIE_DOMAIN=                          # leave empty: the browser only talks to Vercel, which proxies /api/* to Render
EXPOSE_DEV_RESET_TOKENS=false           # local only: true also shows the 6-digit reset code on screen
PASSWORD_RESET_TTL_MINUTES=10           # lifetime of an emailed reset code
PASSWORD_RESET_MAX_ATTEMPTS=5           # wrong codes allowed before the code is burned
# "Sign in with Google": OAuth client ID (Web application) from Google Cloud Console ->
# APIs & Services -> Credentials. Add your site under "Authorized JavaScript origins"
# (local: http://localhost and http://localhost:3000). Unset = the Google button is hidden.
GOOGLE_CLIENT_ID=
AUTH_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=120

# --- Email via Gmail SMTP (password reset, reminders) ---------------------------------------
# Needs 2-Step Verification on the Gmail account and a 16-character *App Password*
# (Google Account -> Security -> App passwords). Never use the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                           # STARTTLS
SMTP_USERNAME=YOUR-ADDRESS@gmail.com
SMTP_PASSWORD=                          # the App Password, without spaces
SMTP_FROM=NyayaSetu <YOUR-ADDRESS@gmail.com>   # Gmail only sends as the signed-in address

# --- Storage (uploaded documents are AES-256-GCM encrypted before storage) ---------------
# Render's free disk is wiped on every deploy/restart: use an S3-compatible bucket
# (e.g. Cloudflare R2, Backblaze B2) for anything you want to keep.
STORAGE_BACKEND=s3                      # local | s3   (local: local)
LOCAL_STORAGE_PATH=./var/storage
STORAGE_ENCRYPTION_KEY=                 # REQUIRED + back it up: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
S3_BUCKET=
S3_ENDPOINT_URL=                        # e.g. the bucket's S3 API endpoint shown in the R2/B2 dashboard
S3_REGION=                              # R2 uses "auto"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=20

# --- LLM (optional; used only for users who consent to external AI processing) -----------
# openai_compatible = any OpenAI-style Chat Completions API, e.g.
#   Groq          LLM_API_BASE=https://api.groq.com/openai/v1                        key: console.groq.com
#   Google Gemini LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai  key: aistudio.google.com
#   OpenRouter    LLM_API_BASE=https://openrouter.ai/api/v1                          key: openrouter.ai
#   xAI Grok      LLM_API_BASE=https://api.x.ai/v1                                   key: console.x.ai
# Copy the exact model ID from the provider's console/model list.
LLM_PROVIDER=openai_compatible          # anthropic | openai_compatible | offline
LLM_API_BASE=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=                              # e.g. a current Grok model ID from console.x.ai
LLM_FALLBACK_MODEL=                     # optional backup model on the same API, tried once on rate limits / outages (e.g. openai/gpt-oss-20b on Groq)
LLM_TIMEOUT_SECONDS=90
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_ENABLE_FALLBACKS=true         # server-side refusal fallbacks (beta)

# --- Embeddings ----------------------------------------------------------------------------
EMBEDDING_PROVIDER=hashing              # hashing (offline, lexical) | openai_compatible
EMBEDDING_DIMENSIONS=384                # changing requires a new migration + re-ingestion
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Speech (Sarvam AI; browser speech is used when unset) ---------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER_HI=priya
SARVAM_TTS_SPEAKER_EN=priya

# --- OCR (scanned documents) ----------------------------------------------------------------
OCR_PROVIDER=tesseract                  # tesseract | none  (backend/Dockerfile installs Tesseract; locally needs the binary + `pip install pytesseract`)
TESSERACT_CMD=

# --- Filing ----------------------------------------------------------------------------------
EJAGRITI_BASE_URL=https://e-jagriti.gov.in
ENABLE_BROWSER_ASSIST=false             # keep false on Render; local deployments only (needs `pip install playwright` + browser)
BROWSER_ASSIST_HEADLESS=false

# --- Legal knowledge ---------------------------------------------------------------------------
LEGAL_FETCH_LIVE=false                  # re-download official PDFs during ingestion and flag changes

# --- Observability -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Frontend (Next.js) — set these in Vercel, not Render --------------------------------------
# Both are read at BUILD time: redeploy on Vercel after changing them.
BACKEND_URL=https://YOUR-API.onrender.com        # server-side: where Next.js proxies /api/*. local: http://localhost:8000
NEXT_PUBLIC_API_WS_URL=wss://YOUR-API.onrender.com   # browser: voice WebSocket origin. local: ws://localhost:8000
